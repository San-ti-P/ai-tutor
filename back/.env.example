# ── LLM Provider ─────────────────────────────────────────────
# Valid: ollama | groq | opencode-go | openai
LLM_PROVIDER=ollama

# -- Ollama (local or cloud) --
OLLAMA_MODEL_NAME=gemma4:e4b-it-q8_0
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=          # Required for Ollama Cloud (https://ollama.com → Settings → Keys)

# -- Groq --
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.1-8b-instant

# -- OpenCode Go ($10/mo subscription) --
# Sign up at https://opencode.ai/auth → subscribe to Go → copy API key
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL_NAME=deepseek-v4-pro
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# -- OpenAI (direct) --
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o
# OPENAI_BASE_URL=         # Custom endpoint for OpenAI-compatible APIs

# ── Langfuse Observability ──────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── OCR — DEFERRED (Mathpix for math extraction, post-MVP) ─
# MATHPIX_APP_ID=
# MATHPIX_APP_KEY=

# ── Storage ─────────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./data/chroma
SQLITE_DB_PATH=./data/tutor.db

# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Agent Config ────────────────────────────────────────────
MAX_ITERATIONS_PER_TASK=15
# OCR_CONFIDENCE_THRESHOLD=0.85
